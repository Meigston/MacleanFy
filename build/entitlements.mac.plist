<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- As três do modelo do electron-builder, que o Electron precisa com o hardened runtime. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <!--
      Deixa o macOS perguntar se o MacleanFy pode controlar o System Events, que é quem
      lê e muda a lista "Abrir ao iniciar sessão". Sem ela, o hardened runtime recusa o
      pedido calado. O macOS só pergunta quando a pessoa clica em "Mostrar apps".
    -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>
  </dict>
</plist>
