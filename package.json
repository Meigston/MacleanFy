{
  "name": "macleanfy",
  "productName": "MacleanFy",
  "version": "0.1.0",
  "private": true,
  "description": "Limpeza do Mac com interface gráfica, de código aberto. Baseado no guhcostan/mac-cleaner-cli.",
  "main": "./out/main/index.js",
  "author": "MacleanFy contributors",
  "license": "MIT",
  "homepage": "https://github.com/Meigston/MacleanFy#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Meigston/MacleanFy.git"
  },
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=22"
  },
  "os": [
    "darwin"
  ],
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint src",
    "test": "vitest run",
    "icon": "electron scripts/make-icon.cjs",
    "dmg:background": "electron scripts/make-dmg-background.cjs",
    "pix:qr": "node scripts/make-pix-qr.cjs",
    "dist": "electron-vite build && electron-builder --mac"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "lucide-react": "^1.55.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^7.3.7",
    "vitest": "^5.0.3",
    "zustand": "^5.0.15"
  }
}
